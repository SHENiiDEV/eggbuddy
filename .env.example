APP_NAME=EggBuddy
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=eggbuddy
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database

# Use "log" while developing (emails land in storage/logs/laravel.log).
# For real delivery switch to smtp, e.g. Namecheap Private Email:
# MAIL_MAILER=smtp
# MAIL_HOST=mail.privateemail.com
# MAIL_PORT=465
# MAIL_SCHEME=smtps
# MAIL_USERNAME=hello@your-domain.com
# MAIL_PASSWORD=secret
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@eggbuddy.example"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Merchant details. These appear in the footer, on every legal page, in emails
# and on invoices. Replace every value with your registered legal entity.
# ---------------------------------------------------------------------------
COMPANY_NAME="Your Company Ltd"
COMPANY_NUMBER="000000000"
COMPANY_VAT_NUMBER=
COMPANY_ADDRESS="Street 1, City, Postcode"
COMPANY_COUNTRY="Country"
COMPANY_EMAIL="support@your-domain.com"
COMPANY_PHONE="+000 0000 0000"
COMPANY_SUPPORT_HOURS="Monday to Friday, 9:00-18:00 CET"
# Courts / law that govern the Terms, e.g. "the Republic of Latvia"
COMPANY_JURISDICTION="the country of registration of the Company"
# Lead data protection authority, e.g. "Data State Inspectorate of Latvia (www.dvi.gov.lv)"
COMPANY_DPA=
# Text shown on the cardholder's bank statement (agree it with your acquirer)
COMPANY_DESCRIPTOR="EGGBUDDY"

LEGAL_EFFECTIVE_DATE=2026-10-05
LEGAL_VERSION=1.0
REGISTRATION_MIN_AGE=18

# ---------------------------------------------------------------------------
# Payments. "demo" is a built-in test gateway: no money moves.
# Disable it (PAYMENT_DEMO_ENABLED=false) before going live and add your PSP
# driver to config/payments.php.
# ---------------------------------------------------------------------------
PAYMENT_GATEWAY=demo
PAYMENT_CURRENCY=EUR
PAYMENT_DEMO_ENABLED=true
PAYMENT_DEMO_WEBHOOK_SECRET=change-me

INVOICE_PREFIX=EB
# Prices are VAT-inclusive. 0 = no VAT shown on invoices.
INVOICE_VAT_RATE=0

# 1 = real time. Raise it (e.g. 60) to make pets age and get hungry faster while testing.
GAME_SPEED=1
